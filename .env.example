# Copy to .env and fill in what you use. Never commit a real .env.
# The system runs fully offline with the defaults below (mock LLM +
# fake embeddings) — no keys required.

# LLM provider: mock | openai | huggingface
CRA_LLM_PROVIDER=mock
CRA_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Embeddings provider: fake | huggingface | openai
CRA_EMBEDDING_PROVIDER=fake
CRA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CRA_EMBEDDING_DIM=384

# Review behaviour
CRA_MAX_FINDINGS=25
CRA_CONTEXT_K=3
CRA_REPO_PATH=
CRA_DATA_DIR=./data

# GitHub (needed for --pr fetching and posting reviews)
GITHUB_TOKEN=

# Server
CRA_HOST=127.0.0.1
CRA_PORT=8000
